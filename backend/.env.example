# =========================================
# FastAPI Scaffold 环境配置示例
# 复制为 .env 并按需修改；.env 不入 git
# =========================================

# ---- 基础配置 ----
ENV=development
PROJECT_NAME=fastapi-scaffold
API_V1_STR=/api/v1
API_PORT=8001

# ---- Docker 端口映射（主机端口:容器端口） ----
POSTGRES_PORT=5434
REDIS_PORT=6382
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
FLOWER_PORT=5555
REDIS_EXTERNAL_PORT=6382

# ---- Nginx 反向代理 ----
SERVER_NAME=localhost
# 跨域允许来源，多个用逗号分隔，如 https://a.com,https://b.com
# 生产环境必填，开发环境留空即允许全部（["*"]）
CORS_ALLOWED_ORIGINS=

# ---- 数据库 ----
# Docker 内用服务名 postgres；本地裸跑改为 localhost
POSTGRES_HOST=postgres
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo123
POSTGRES_DB=fastapi_scaffold

# ---- Redis ----
# Docker 内用服务名 redis；本地裸跑改为 localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- HTTP 代理（一般不需要开启） ----
USE_HTTP_PROXY=false
HTTP_PROXY=
HTTPS_PROXY=

# ---- 邮件（默认未启用，保留默认即可） ----
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=user
MAIL_PASSWORD=password
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=FastAPI Scaffold
MAIL_ENCRYPTION=none

# Brevo 邮件服务（默认未启用）
BREVO_API_KEY=dummy-api-key
BREVO_EMAIL_FROM=noreply@example.com
BREVO_EMAIL_FROM_NAME=FastAPI Scaffold

# ---- 管理员 ----
ADMIN_EMAIL=admin@example.com

# ---- JWT ----
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- AWS S3（默认未启用，使用本地存储） ----
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket
AWS_ENDPOINT=https://s3.amazonaws.com

# ---- OpenAI（可选） ----
OPENAI_API_KEY=your-openai-api-key

# ---- DeepSeek AI（按需启用） ----
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
